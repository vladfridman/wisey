package wisey.threads;

import wisey.data.CReferenceToReferenceMap;
import wisey.data.CReferenceToOwnerMap;

/**
 * Manages instances of context injected objects
 */
controller CContextManager {
  inject immediate CReferenceToReferenceMap* mContextNameToContextMap;
  inject immediate CReferenceToOwnerMap* mContextToObjectMap;

  /**
   * Find the existing instance of the object with the given name in the given context
   */
  public ::wisey::object getInstance(string contextName, string objectName) {
    ::wisey::object context = mContextNameToContextMap:wisey.data.CReferenceToReferenceMap*:get(contextName) -> ::wisey::object;
    if (context == null) {
      throw build(MContextNonExistantException).withContextName(contextName).onHeap() -> MContextNonExistantException*;
    }
    CReferenceToOwnerMap objectNameToObjectMap = mContextToObjectMap:wisey.data.CReferenceToOwnerMap*:get(context) -> CReferenceToOwnerMap;
    return objectNameToObjectMap:wisey.data.CReferenceToOwnerMap:get(objectName) -> ::wisey::object;
  }

  /**
   * Set current context to the given object value
   */
  public void setContext(string contextName, ::wisey::object context) {
    mContextNameToContextMap:wisey.data.CReferenceToReferenceMap*:put(contextName, context);
    CReferenceToReferenceMap objectNameToObjectMap = mContextToObjectMap:wisey.data.CReferenceToOwnerMap*:get(context) -> CReferenceToReferenceMap;
    if (objectNameToObjectMap == null) {
      mContextToObjectMap:wisey.data.CReferenceToOwnerMap*:put(context, CReferenceToOwnerMap.create() -> CReferenceToOwnerMap*);
    }
  }

  /**
   * Removes all objects stored in the given context
   */
  public void eraseContext(string contextName) {
    ::wisey::object context = mContextNameToContextMap:wisey.data.CReferenceToReferenceMap*:get(contextName) -> ::wisey::object;
    if (context == null) {
      return;
    }
    mContextToObjectMap:wisey.data.CReferenceToOwnerMap*:erase(context);
    mContextNameToContextMap:wisey.data.CReferenceToReferenceMap*:erase(contextName);
  }

  /**
   * Set injected object instance in the given context
   */
  public void setInstance(string contextName, string objectName, ::wisey::object* instance) {
    ::wisey::object context = mContextNameToContextMap:wisey.data.CReferenceToReferenceMap*:get(contextName) -> ::wisey::object;
    if (context == null) {
      throw build(MContextNonExistantException).withContextName(contextName).onHeap() -> MContextNonExistantException*;
    }
    CReferenceToOwnerMap objectNameToObjectMap = mContextToObjectMap:wisey.data.CReferenceToOwnerMap*:get(context) -> CReferenceToOwnerMap;
    objectNameToObjectMap:wisey.data.CReferenceToOwnerMap:put(objectName, instance);
  }
}