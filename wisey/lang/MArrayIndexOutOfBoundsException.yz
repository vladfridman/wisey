package wisey.lang;

/**
 * This is thrown when index in an array is used that is out of array range
 */
model MArrayIndexOutOfBoundsException implements IException {
  /**
   * Size of the array that threw the exception
   */
  receive long mArraySize;

  /**
   * Index used on the array that threw the exception
   */
  receive long mIndex;

  public NString* report() override {
    NString* message = callstack:wisey.threads.CCallStack:reportException(this) -> NString*;
    message:wisey.lang.NString*:appendString("Details: Index ");
    message:wisey.lang.NString*:appendNString(NString.createFromLong(mIndex) -> NString*);
    message:wisey.lang.NString*:appendString(" is used on array of size ");
    message:wisey.lang.NString*:appendNString(NString.createFromLong(mArraySize) -> NString*);
    message:wisey.lang.NString*:appendString("\n");

    return message;
  }

  /**
   * Returns array size
   */
  public long getArraySize() {
    return mArraySize;
  }

  /**
   * Returns index used on the array
   */
  public long getIndex() {
    return mIndex;
  }
}
