package wisey.lang;

/**
 * Thrown when attempting to destroy an object that still has active references pointing to it
 */
model MReferenceCountException implements IException {

  /**
   * Object type that threw the exception
   */
  receive string mObjectType;

  /**
   * Number of references that the object still has
   */
  receive long mReferenceCount;

  /**
   * Pointer to the exception from which this one was thrown
   */
  receive IException mNestedException;

  public NString* report() override {
    if (mNestedException instanceof MReferenceCountException) {
      return mNestedException:wisey.lang.IException.report() -> NString*;
    }

    NString* message = callstack:wisey.threads.CCallStack.reportException(this) -> NString*;
    string ending = mReferenceCount > 1 ? "s" : "";
    message:wisey.lang.NString*.appendString("Details: Object referenced by expression of type ");
    message:wisey.lang.NString*.appendString(mObjectType);
    message:wisey.lang.NString*.appendString(" still has ");
    message:wisey.lang.NString*.appendNString(NString.createFromLong(mReferenceCount) -> NString*);
    message:wisey.lang.NString*.appendString(" active reference");
    message:wisey.lang.NString*.appendString(ending);
    message:wisey.lang.NString*.appendString("\n");

    if (mNestedException == null) {
      return message;
    }
    message:wisey.lang.NString*.appendString("Was thrown from memory clean up after ");
    message:wisey.lang.NString*.appendString(MSystem.getOriginalObjectTypeName(mNestedException) -> string);
    message:wisey.lang.NString*.appendString("\n");
    message:wisey.lang.NString*.appendNString(mNestedException:wisey.lang.IException.report() -> NString*);

    return message;
  }

  /**
   * Returns the number of references that are still pointing to the object
   */
  public long getReferenceCount() {
    return mReferenceCount;
  }

  /**
   * Returns the object type name
   */
  public string getObjectType() {
    return mObjectType;
  }
}
