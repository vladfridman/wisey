package wisey.performance.testing;

import wisey.io.CTextStreamReader;
import wisey.data.COwnerVector;
import wisey.data.CLongToIntMap;
import wisey.data.IObjectComparator;
import wisey.lang.CMemoryPool;
import wisey.lang.IProgram;
import wisey.lang.MSystem;
import wisey.lang.NString;
import wisey.threads.IThread;
import wisey.threads.IWorker;
import wisey.threads.CThreadPool;

/**
 * Tests Wisey performance analogous to the k-nucleotide test from The Benchmarks Game 
 *
 * The test needs an input file that is craeted by another program called faster 
 * It is easiest to run java to generate the input file and then feed it into this test
 * The command to generate the input file and then run this test shoud be in command.txt file
 */
controller CKNucleotide implements IProgram, IObjectComparator {
  private constant byte[] CODES = { -1b, 0b, -1b, 1b, 3b, -1b, -1b, 2b };
  private constant char[] NUCLEOTIDES = { 'A', 'C', 'G', 'T' };

  // Thread pool for running workers process part of the input
  inject immediate CThreadPool* mThreadPool.withPoolSize(MSystem.getProcessorCount());

  // Execution starts here, input data is read from standard input
  public int run(immutable string[] arguments) override {
    immutable byte[]* sequence = read() -> immutable byte[]*;

    int[] fragmentLengths = { 1, 2, 3, 4, 6, 12, 18 };
    CFragment*[]* fragments = createFragments(sequence, fragmentLengths) -> CFragment*[]*;


    NString stringBuilder = NString.create() -> NString*;
    stringBuilder:wisey.lang.NString:appendNString(writeFrequencies((float) sequence.getSize(), fragments[0]) -> NString*);
    stringBuilder:wisey.lang.NString:appendNString(
      writeFrequencies((float) (sequence.getSize() -> long) - 1.0,
      sumTwoMaps(fragments[1], fragments[2]) -> CFragment) -> NString*);

    string[]* nucleotideFragments = { "GGT", "GGTA", "GGTATT", "GGTATTTTAATT", "GGTATTTTAATTTATAGT" };
    for (int i = 0; i < nucleotideFragments.getSize() -> long; i++) {
      string nucleotideFragment = nucleotideFragments[i];
      stringBuilder:wisey.lang.NString:appendNString(writeCount(fragments, nucleotideFragment) -> NString*);
    }

    printout(stringBuilder);
    return 1;
  }

  /**
   * This devides work into subparts and launches workers on a thread pool to do the work
   */
  private CFragment*[]* createFragments(immutable byte[] sequence, int[] fragmentLengths) {
    int arrayIndex = 0;
    for (int i = 0; i < fragmentLengths.getSize() -> long; i++) {
      int fragmentLength = fragmentLengths[i];
      for (int index = 0; index < fragmentLength; index++) {
        int offset = index;
        MFragmentWorker* worker = build(MFragmentWorker)
          .withSequence(sequence)
          .withOffset(offset)
          .withFragmentLength(fragmentLength)
          .withArrayIndex(arrayIndex)
          .onHeap() -> MFragmentWorker*;
        mThreadPool:wisey.threads.CThreadPool*:submit(worker);
        arrayIndex++;
      }
    }
    mThreadPool:wisey.threads.CThreadPool*:start();
    CFragment*[]* fragments = new CFragment*[arrayIndex];
    for (int i = 0; i < fragments.getSize() -> long; i++) {
      MFragmentWorkerResult* result = mThreadPool:wisey.threads.CThreadPool*:getResult() -> MFragmentWorkerResult*;
      fragments[result:wisey.performance.testing.CKNucleotide.MFragmentWorkerResult*:getArrayIndex()] = result:wisey.performance.testing.CKNucleotide.MFragmentWorkerResult*:toController() -> CFragment*;
    }
    mThreadPool:wisey.threads.CThreadPool*:waitAndStop();
    return fragments;
  }

  /**
   * Computation is devided into fragments, each fragment computed by a separate worker
   */
  private model MFragmentWorker implements IWorker {
    immutable byte[] mSequence;
    int mOffset;
    int mFragmentLength;
    int mArrayIndex;

    /**
     * work() method is where execution starts for an IWorker
     */
    public void work() override {
      CLongToIntMap map = inject(CFragmentWorkerContext).onHeap():CKNucleotide.CFragmentWorkerContext:getMap() -> CLongToIntMap;
      int lastIndex = (int) (mSequence.getSize() -> long) - mFragmentLength + 1;
      for (int index = mOffset; index < lastIndex; index += mFragmentLength) {
        long key = 0;
        for (int i = index; i < index + mFragmentLength; i++) {
          key = key * 4 + mSequence[i];
        }
        map:wisey.data.CLongToIntMap:addTo(key, 1);
      }

      MFragmentWorkerResult* result = build(MFragmentWorkerResult)
        .withKeys(map:wisey.data.CLongToIntMap:getKeys() -> long[]*)
        .withValues(map:wisey.data.CLongToIntMap:getValues() -> int[]*)
        .withKeyLength(mFragmentLength)
        .withArrayIndex(mArrayIndex)
        .onHeap() -> MFragmentWorkerResult*;
      map:wisey.data.CLongToIntMap:clear();
      thread:wisey.threads.IThread:send(result);
    }
  }

  /**
   * MFragmentWorker's result is a model that is passed back to the calling thread
   *
   * Result of the MFragmentWorker computation is a long to int map, but it can not
   * be passed between threads because it is a controller which is mutable. 
   * Therefore we have to pass arrays of keys and values and then reconstruct the map
   * at the recieving side
   */
  private model MFragmentWorkerResult {
    immutable long[]* mKeys;
    immutable int[]* mValues;
    int mKeyLength;
    int mArrayIndex;

    /**
     * Convert arrays of keys and values into a map
     */
    public CFragment* toController() {
      CFragment* fragment = inject(CFragment)
        .withKeyLength(mKeyLength)
        .onHeap() -> CFragment*;
      for (int i = 0; i < mKeys.getSize() -> long; i++) {
        fragment:wisey.performance.testing.CKNucleotide.CFragment*:getMap():wisey.data.CLongToIntMap:put(mKeys[i], mValues[i]);
      }
      return fragment;
    }

    public int getArrayIndex() {
      return mArrayIndex;
    }
  }

  /**
   * Represents result of MFragmentWorker computation with the results converted into a map
   */
  private controller CFragment {
    inject CLongToIntMap* mMap;
    receive int mKeyLength;

    public CLongToIntMap getMap() {
      return mMap;
    }

    public int getKeyLength() {
      return mKeyLength;
    }
  }

  /**
   * Represents aggregated result key/value pair
   */
  private node NKeyValuePair {
    receive long mKey;
    receive int mValue;

    public long getKey() {
      return mKey;
    }

    public int getValue() {
      return mValue;
    }
  }

  /**
   * This context injected object provides one instance of CLongToIntMap for one IThread
   */
  private controller CFragmentWorkerContext inScope IThread {
    inject immediate CLongToIntMap* mMap;

    public CLongToIntMap getMap() {
      return mMap;
    }
  }

  /**
   * Used to compute keys to check performance test correctness
   */
  private static long getKey(byte[] arr, int offset, int length) {
    long key = 0;
    for (int i = offset; i < offset + length; i++) {
      key = key * 4 + arr[i];
    }
    return key;
  }

  /**
   * Sums two maps of int to long from two fragments
   */
  private CFragment sumTwoMaps(CFragment fragment1, CFragment fragment2) {
    long[]* keysArray = fragment2:wisey.performance.testing.CKNucleotide.CFragment:getMap():wisey.data.CLongToIntMap:getKeys() -> long[]*;
    int[]* valuesArray = fragment2:wisey.performance.testing.CKNucleotide.CFragment:getMap():wisey.data.CLongToIntMap:getValues() -> int[]*;
    for (int i = 0; i < keysArray.getSize() -> long; i++) {
      long key = keysArray[i];
      fragment1:wisey.performance.testing.CKNucleotide.CFragment:getMap():wisey.data.CLongToIntMap:addTo(key, valuesArray[i]);
    }
    return fragment1;
  }

  /**
   * Writes test results into a string
   */
  private NString* writeFrequencies(float totalCount, CFragment frequencies) {
    long[]* keysArray = frequencies:wisey.performance.testing.CKNucleotide.CFragment:getMap():wisey.data.CLongToIntMap:getKeys() -> long[]*;
    int[]* valuesArray = frequencies:wisey.performance.testing.CKNucleotide.CFragment:getMap():wisey.data.CLongToIntMap:getValues() -> int[]*;
    COwnerVector* vector = inject(COwnerVector).onHeap() -> COwnerVector*;
    for (int i = 0; i < keysArray.getSize() -> long; i++) {
      NKeyValuePair* pair = build(NKeyValuePair)
        .withKey(keysArray[i])
        .withValue(valuesArray[i])
        .onHeap() -> NKeyValuePair*;
      vector:wisey.data.COwnerVector*:pushBack(pair);
    }
    vector:wisey.data.COwnerVector*:sort(this);
    NString* sb = NString.create() -> NString*;
    int keyLength = frequencies:wisey.performance.testing.CKNucleotide.CFragment:getKeyLength() -> int;
    long entryCount = vector:wisey.data.COwnerVector*:getSize() -> long;
    for (long i = 0l; i < entryCount; i++) {
      NKeyValuePair pair = (NKeyValuePair) (vector:wisey.data.COwnerVector*:getAt(i) -> ::wisey::object);
      sb:wisey.lang.NString*:appendNString(keyToString(pair:wisey.performance.testing.CKNucleotide.NKeyValuePair:getKey() -> long, keyLength) -> NString*);
      sb:wisey.lang.NString*:appendString(" ");
      sb:wisey.lang.NString*:appendNString(formatFloat3(((float) (pair:wisey.performance.testing.CKNucleotide.NKeyValuePair:getValue() -> int)) * 100.0 / totalCount) -> NString*);
      sb:wisey.lang.NString*:appendString("\n");
    }
    sb:wisey.lang.NString*:appendString("\n");
    return sb;
  }

  /**
   * Format a float with 3 decimal places (matches Java's "%.3f" output).
   * NString.createFromFloat uses 6-decimal default; Java's printf rounds
   * to half-up at the last digit, which `(long)(v * 1000 + 0.5)` matches
   * for the positive values we produce here.
   */
  private static NString* formatFloat3(float value) {
    long scaled = (long) (value * 1000.0 + 0.5);
    long whole = scaled / 1000;
    long frac = scaled - whole * 1000;
    NString* sb = NString.create() -> NString*;
    sb:wisey.lang.NString*:appendNString(NString.createFromLong(whole) -> NString*);
    sb:wisey.lang.NString*:appendString(".");
    if (frac < 100) { sb:wisey.lang.NString*:appendString("0"); }
    if (frac < 10) { sb:wisey.lang.NString*:appendString("0"); }
    sb:wisey.lang.NString*:appendNString(NString.createFromLong(frac) -> NString*);
    return sb;
  }

  /**
   * Compare function used for sorting of the NKeyValuePair vector.
   * Returns true when `left` should come before `right` — i.e., when
   * left's count is GREATER (descending order, matching Java's
   * Comparator.reverseOrder() on getValue).
   */
  private boolean compare(NKeyValuePair left, NKeyValuePair right) override {
    return left:wisey.performance.testing.CKNucleotide.NKeyValuePair:getValue() -> int > right:wisey.performance.testing.CKNucleotide.NKeyValuePair:getValue() -> int;
  }

  /**
   * Not sure what this does but it repeats the algorithm from Java version of the test
   */
  private static NString* keyToString(long keyParam, int length) {
    long key = keyParam;
    char[]* res = new char[length];
    for (int i = 0; i < length; i++) {
      res[length - i - 1] = NUCLEOTIDES[(int) (key & 0x3)];
      key = key >> 2;
    }
    return NString.createFromCharArray(res) -> NString*;
  }

  /**
   * Writes other test results into a string
   */
  private NString* writeCount(CFragment*[] fragments, string nucleotideFragment) {
    byte[]* key = toCodesFromString(nucleotideFragment) -> byte[]*;
    long k = getKey(key, 0, (int) nucleotideFragment.getLength()) -> long;
    int count = 0;
    for (int i = 0; i < fragments.getSize() -> long; i++) {
      CFragment fragment = (CFragment) fragments[i];
      if (fragment:wisey.performance.testing.CKNucleotide.CFragment:getKeyLength() -> int == nucleotideFragment.getLength() -> long) {
        if (fragment:wisey.performance.testing.CKNucleotide.CFragment:getMap():wisey.data.CLongToIntMap:has(k)) {
          count += fragment:wisey.performance.testing.CKNucleotide.CFragment:getMap():wisey.data.CLongToIntMap:get(k) -> int;
        }
      }
    }

    NString* value = NString.createFromInt(count) -> NString*;
    value:wisey.lang.NString*:appendString("\t");
    value:wisey.lang.NString*:appendString(nucleotideFragment);
    value:wisey.lang.NString*:appendString("\n");
    return value;
  }

  /**
   * Take nucleotide fragment and convert it to byte array of codes
   */
  private static byte[]* toCodesFromString(string input) {
    NString* nstring = NString.createFromString(input) -> NString*;
    char[] nstringContent = nstring:wisey.lang.NString*:getContent() -> char[];
    byte[]* result = new byte[nstringContent.getSize() -> long - 1];
    for (int i = 0; i < nstringContent.getSize() -> long - 1; i++) {
      result[i] = CODES[(byte) nstringContent[i] & 0x7];
    }
    return result;
  }

  /**
   * Reads input data from standard input
   */
  private byte[]* read() {
    NString* line = NString.create() -> NString*;
    CTextStreamReader* stream = CTextStreamReader.openSystemIn() -> CTextStreamReader*;
    while ((line = stream:wisey.io.CTextStreamReader*:readLineIntoNString(line) -> NString*) != null) {
      if (line:wisey.lang.NString*:startsWith(">THREE")) {
        break;
      }
    }

    byte[]* bytes = new byte[1048576];
    long position = 0;
    while ((line = stream:wisey.io.CTextStreamReader*:readLineIntoNString(line) -> NString*) != null && line:wisey.lang.NString*:charAt(0) -> char != '>') {
      if (line:wisey.lang.NString*:getLength() -> long + position > bytes.getSize() -> long) {
        byte[]* newBytes = new byte[bytes.getSize() -> long * 2];
        MSystem.copyMemory(newBytes, bytes, position);
        bytes = newBytes;
      }
      for (int i = 0; i < line:wisey.lang.NString*:getLength() -> long; i++) {
        bytes[position++] = (byte) line:wisey.lang.NString*:charAt(i);
      }
    }
    stream:wisey.io.CTextStreamReader*:close();

    return toCodes(bytes, position) -> byte[]*;
  }

  /**
   * Converts input data into nucleotide codes
   */
  private static byte[]* toCodes(byte[] sequence, long length) {
    byte[]* result = new byte[length];
    for (int i = 0; i < length; i++) {
      result[i] = CODES[sequence[i] & 0x7];
    }
    return result;
  }
}

bind(IProgram, CKNucleotide);
