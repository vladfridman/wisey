package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

interface IHasSomething {
  int getSomething();
}

interface IHasValue {
  int getValue();
}

model MObject implements IHasValue {
  public int getValue() override {
    return 1;
  }
}

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    ::wisey::model object = build(MObject).onHeap() ~> MObject*;
    IHasSomething hasSomething = object;
    return hasSomething:systems.vos.wisey.compiler.tests.IHasSomething->getSomething() ~> int;
  }
}

bind(IProgram, CProgram);
