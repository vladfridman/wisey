package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

model MContainer {
  int mContent;

  public int getContent() {
    return mContent;
  }
}

model MMyModel {
  immutable MContainer[][]* mArray;

  public int getValue() {
    return mArray[3][3]:systems.vos.wisey.compiler.tests.MContainer->getContent() ~> int;
  }
}

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    MContainer[][]* array = new MContainer[4][4];
    array[3][3] = build(MContainer).withContent(3).onHeap() ~> MContainer*;
    MMyModel* mymodel = build(MMyModel).withArray(array).onHeap() ~> MMyModel*;
    return mymodel:systems.vos.wisey.compiler.tests.MMyModel*->getValue() ~> int;
  }
}

bind(IProgram, CProgram);
