package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    CProgram.MMyModel* object = build(CProgram.MMyModel).withValue(7).onHeap() -> CProgram.MMyModel*;

    return object:systems.vos.wisey.compiler.tests.CProgram.MMyModel*:getValue() -> int;
  }

  public model MMyModel {
    int mValue;

    public int getValue() {
      return mValue;
    }
  }
}

bind(IProgram, CProgram);
