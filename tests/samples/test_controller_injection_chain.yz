package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

controller CTopController {
  inject CMiddleController* mMiddleController;

  public int get1() {
    return mMiddleController:systems.vos.wisey.compiler.tests.CMiddleController*:get2() -> int;
  }
}

controller CMiddleController {
  inject CBottomController* mBottomController;

  public int get2() {
    return mBottomController:systems.vos.wisey.compiler.tests.CBottomController*:get3() -> int;
  }
}

controller CBottomController {

  public int get3() {
    return 2;
  }
}

controller CProgram implements IProgram {
  inject CTopController* mTopController;

  public int run(immutable string[] arguments) override {
    return mTopController:systems.vos.wisey.compiler.tests.CTopController*:get1() -> int;
  }
}

bind(IProgram, CProgram);

