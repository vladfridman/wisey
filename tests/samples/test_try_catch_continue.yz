package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

model MException {
  int mValue;

  public int getValue() {
    return mValue;
  }
}

controller CThrower {
  public int doThrow() throws MException {
    MException exception = build(MException).withValue(255).onHeap() ~> MException*;
    return 3;
  }
}

controller CCatcher {
  inject CThrower* mThrower;

  public int doTryCatch() {
    try {
      mThrower:systems.vos.wisey.compiler.tests.CThrower*->doThrow();
      return 7;
    } catch (MException* exception) {
      return exception:systems.vos.wisey.compiler.tests.MException*->getValue() ~> int;
    }
  }
}

controller CProgram implements IProgram {
  inject CCatcher* mCatcher;

  public int run(immutable string[] arguments) override {
    return mCatcher:systems.vos.wisey.compiler.tests.CCatcher*->doTryCatch() ~> int;
  }
}

bind(IProgram, CProgram);
