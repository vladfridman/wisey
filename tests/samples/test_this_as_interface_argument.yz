package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

interface IHasValue {
  int getValue();
}

model MCaller {
  public int makeCall(IHasValue object) {
    return object:systems.vos.wisey.compiler.tests.IHasValue->getValue() ~> int;
  }
}

controller CProgram implements IProgram, IHasValue {

  public int run(immutable string[] arguments) override {
    MCaller* caller = build(MCaller).onHeap() ~> MCaller*;

    return caller:systems.vos.wisey.compiler.tests.MCaller*->makeCall(this) ~> int;
  }

  public int getValue() override {
    return 5;
  }
}

bind(IProgram, CProgram);
