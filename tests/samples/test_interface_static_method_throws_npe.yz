package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

interface IShape {
  public static int getValue(MValueContainer valueContainer) {
    return valueContainer:systems.vos.wisey.compiler.tests.MValueContainer.getValue() -> int;
  }
}

model MValueContainer {
  int mValue;

  public int getValue() {
    return mValue;
  }
}

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    MValueContainer* valueContainer = build(MValueContainer).withValue(7).onHeap() -> MValueContainer*;
    MValueContainer* anotherContainer = valueContainer;
    return IShape.getValue(valueContainer) -> int;
  }
} 

bind(IProgram, CProgram);
