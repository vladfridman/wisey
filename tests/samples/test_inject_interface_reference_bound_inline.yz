package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

controller CService inScope wisey.threads.IThread implements IMyInterface {

  public int getValue() override {
    return 5;
  }
}

interface IMyInterface {
  int getValue();
}

controller CProgram implements IProgram {
  public int run(immutable string[] arguments) override {
    IMyInterface reference = inject(IMyInterface).onHeap() -> IMyInterface;
    return reference:systems.vos.wisey.compiler.tests.IMyInterface:getValue() -> int;
  }
}

bind(IProgram, CProgram);
bind(IMyInterface, CService);
