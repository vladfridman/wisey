package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;
import wisey.lang.MString;

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    MString* mstring = MString.createFromString("test") -> MString*;
    char[]* array = new char[5];
    array[0] = 't';
    array[1] = 'e';
    array[2] = 's';
    array[3] = 't';
    return mstring.compareToString("test") -> int
      + mstring.compareToMString(mstring) -> int
      + mstring.compareToImmutableCharArray(mstring.getContent() -> immutable char[]) -> int
      + mstring.compareToCharArray(array) -> int;
  }
}

bind(IProgram, CProgram);
