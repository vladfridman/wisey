package systems.vos.wisey.compiler.tests;

import wisey.lang.IException;
import wisey.lang.IProgram;
import wisey.lang.NString;

model MException implements IException {
  int mValue;

  public int getValue() {
    return mValue;
  }

  public NString* report() override {
    return callstack:wisey.threads.CCallStack.reportException(this) -> NString*;
  }
}

model MAnotherException implements IException {
  int mValue;

  public int getValue() {
    return mValue;
  }

  public NString* report() override {
    return callstack:wisey.threads.CCallStack.reportException(this) -> NString*;
  }
}

controller CThrower {
  public int doThrow() throws MException, MAnotherException {
    throw build(MAnotherException).withValue(127).onHeap() -> MAnotherException*;
  }
}

controller CCatcher {
  inject CThrower* mThrower;

  public int doTryCatch() {
    try {
      mThrower:systems.vos.wisey.compiler.tests.CThrower*.doThrow();
    } catch (MException* exception) {
      return exception:systems.vos.wisey.compiler.tests.MException*.getValue() -> int;
    } catch (MAnotherException* exception) {
      return exception:systems.vos.wisey.compiler.tests.MAnotherException*.getValue() -> int;
    }
    return 5;
  }
}

controller CProgram implements IProgram {
  inject CCatcher* mCatcher;

  public int run(immutable string[] arguments) override {
    return mCatcher:systems.vos.wisey.compiler.tests.CCatcher*.doTryCatch() -> int;
  }
}

bind(IProgram, CProgram);
