package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

model MData {
  int mValue;

  public int getValue() {
    return mValue;
  }
}

controller CService {
  state MData mData;

  public void set(MData data) {
    mData = data;
  }

  public int getValue() {
    return mData:systems.vos.wisey.compiler.tests.MData:getValue() -> int;
  }
}

controller CProgram implements IProgram {
  inject CService* mService;

  public int run(immutable string[] arguments) override {
    MData* owner = build(MData).withValue(1).onHeap() -> MData*;
    mService:systems.vos.wisey.compiler.tests.CService*:set(owner);
    owner = build(MData).withValue(5).onHeap() -> MData*;

    return mService:systems.vos.wisey.compiler.tests.CService*:getValue() -> int;
  }
} 

bind(IProgram, CProgram);
