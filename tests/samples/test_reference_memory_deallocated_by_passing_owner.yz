package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

model MData {
  int mValue;

  public int getValue() {
    return mValue;
  }
}

controller CService {
  public void capture(MData* data) {

  }
}

controller CProgram implements IProgram {
  inject CService* mService;

  public int run(immutable string[] arguments) override {
    MData* data = build(MData).withValue(5).onHeap() -> MData*;
    MData dataRef = data;
    MData anotherRef = dataRef;
    mService:systems.vos.wisey.compiler.tests.CService*:capture(data);
    
    return anotherRef:systems.vos.wisey.compiler.tests.MData:getValue() -> int;
  }
} 

bind(IProgram, CProgram);
