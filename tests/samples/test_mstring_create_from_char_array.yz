package systems.vos.wisey.compiler.tests;

import wisey.lang.NString;
import wisey.lang.IProgram;
import wisey.lang.MString;

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    char[]* array = new char[4];
    array[0] = 'a';
    array[1] = 'b';
    array[2] = 'c';
    MString* mstring = MString->createFromCharArray(array) ~> MString*;
    printout("mstring: " + mstring + " length: " + mstring:wisey.lang.MString*->getLength() ~> long + "\n");
    return (int) mstring:wisey.lang.MString*->getLength() ~> int;
  }
}

bind(IProgram, CProgram);
