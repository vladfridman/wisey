package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

model MData {
  public int getResult() {
    return 3;
  }
}

controller CService {
  state MData* mData;

  public MData* newData() {
    MData* data = build(MData).onHeap() ~> MData*;
    return data;
  }

  public void setData(MData* data) {
    mData = data;
  }

  public int getData() {
    return mData:systems.vos.wisey.compiler.tests.MData*->getResult() ~> int;
  }
}

controller CProgram implements IProgram {
  inject CService* mService;

  public int run(immutable string[] arguments) override {
    MData* data = mService:systems.vos.wisey.compiler.tests.CService*->newData() ~> MData*;
    mService:systems.vos.wisey.compiler.tests.CService*->setData(data);
    return mService:systems.vos.wisey.compiler.tests.CService*->getData() ~> int;
  }
}

bind(IProgram, CProgram);
