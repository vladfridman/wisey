package systems.vos.wisey.compiler.tests.multifile;

model MAdder {
  public int add(int a, int b) {
    MDoer doer = build(MDoer).onHeap() ~> MDoer*;

    return doer:systems.vos.wisey.compiler.tests.multifile.MDoer->get(a) ~> int + doer:systems.vos.wisey.compiler.tests.multifile.MDoer->get(b) ~> int;
  }
}
