package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

model MModel {
  int mValue;

  public int getValue() {
    return mValue;
  }
}

controller CService {
  state MModel* mModel;
  state MModel* mAnotherModel;

  public void setModel() {
    mModel = build(MModel).withValue(7).onHeap() -> MModel*;
  }

  public void setAnotherModel() {
    mAnotherModel = mModel;
  }

  public int getValue() {
    return mModel:systems.vos.wisey.compiler.tests.MModel*:getValue() -> int;
  }
}

controller CProgram implements IProgram {
  inject CService* mService;

  public int run(immutable string[] arguments) override {
    mService:systems.vos.wisey.compiler.tests.CService*:setModel();
    mService:systems.vos.wisey.compiler.tests.CService*:setAnotherModel();
    return mService:systems.vos.wisey.compiler.tests.CService*:getValue() -> int;
  }
} 

bind(IProgram, CProgram);
