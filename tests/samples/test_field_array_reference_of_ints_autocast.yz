package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

controller CController {
  receive int[][] mArray;

  public void setValue(boolean value) {
    mArray[4][2] = value;
  }

  public int getValue() {
    return mArray[4][2];
  }
}

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    int[][]* array = new int[5][3];
    CController* mycontroller = inject(CController).withArray(array).onHeap() -> CController*;
    mycontroller:systems.vos.wisey.compiler.tests.CController*.setValue(true);

    return mycontroller:systems.vos.wisey.compiler.tests.CController*.getValue() -> int;
  }
}

bind(IProgram, CProgram);
