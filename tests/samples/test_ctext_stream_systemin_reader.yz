package systems.vos.wisey.compiler.tests;

import wisey.io.CTextStreamReader;
import wisey.lang.NString;
import wisey.lang.IProgram;

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    CTextStreamReader* stream = CTextStreamReader->openSystemIn() ~> CTextStreamReader*;
    NString* line = stream:wisey.io.CTextStreamReader*->readLine() ~> NString*;
    while (line) {
      printout("line: " + line);
      line = stream:wisey.io.CTextStreamReader*->readLine() ~> NString*;

    }

    return 1;
  }
}

bind(IProgram, CProgram);
