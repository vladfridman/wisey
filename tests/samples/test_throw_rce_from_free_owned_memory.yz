package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

model MCar {
  public int getYear() {
    return 2018;
  }
}

controller CProgram implements IProgram {
  state MCar mCarRef;

  public int run(immutable string[] arguments) override {
    try {
      mCarRef = build(MCar).onHeap() -> MCar*;
      MCar* owner = null;
      return owner:systems.vos.wisey.compiler.tests.MCar*:getYear() -> int;
    } catch (wisey.lang.MNullPointerException* exception) {
      printerr("Caught!!!\n");
      exception:wisey.lang.MNullPointerException*:report();
    }
    return 0;
  }
}

bind(IProgram, CProgram);
