package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

interface IWheel {
  int getWidth();
}

model MWheel implements IWheel {
  public int getWidth() override {
    return 15;
  }
}

model MCar {
  IWheel* mWheel;

  public int getWheelWidth() {
    return mWheel.getWidth();                                         // -> int
  }
}

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    IWheel* wheel = build(MWheel).onHeap();                           // -> MWheel*
    MCar* car = build(MCar).withWheel(wheel).onHeap();                // -> MCar*
    return car.getWheelWidth();                                       // -> int
  }
}

bind(IProgram, CProgram);
