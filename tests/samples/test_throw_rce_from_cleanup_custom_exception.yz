package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;
import wisey.lang.NString;

model MData {
  int mValue;

  public int getValue() {
    return mValue;
  }
}

model MMyException implements wisey.lang.IException {
  public NString* report() override {
    return callstack:wisey.threads.CCallStack:reportException(this) -> NString*;
  }
}

controller CService {
  public void throwException(MData* data) throws MMyException {
    MMyException* myException = build(MMyException).onHeap() -> MMyException*;
    throw myException;
  }
}

controller CProgram implements IProgram {
  inject CService* mService;

  public int run(immutable string[] arguments) override {
    try {
      MData* data = build(MData).withValue(1).onHeap() -> MData*;
      MData dataRef = data;
      MData dataRef2 = data;
      mService:systems.vos.wisey.compiler.tests.CService*:throwException(data);
    } catch (MMyException* exception) {
      printout("cought exception\n");
    }

    return 1;
  }
} 

bind(IProgram, CProgram);
