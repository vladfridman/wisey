package systems.vos.wisey.compiler.tests;

import wisey.data.COwnerVector;
import wisey.data.IObjectComparator;
import wisey.lang.IProgram;

model MCar {
  int mYear;

  public int getYear() {
    return mYear;
  }
}

controller CProgram implements IProgram, IObjectComparator {
  inject COwnerVector* mVector;

  public int run(immutable string[] arguments) override {
    mVector:wisey.data.COwnerVector*:pushBack(build(MCar).withYear(2018).onHeap() -> MCar*);
    mVector:wisey.data.COwnerVector*:pushBack(build(MCar).withYear(2017).onHeap() -> MCar*);
    mVector:wisey.data.COwnerVector*:pushBack(build(MCar).withYear(2016).onHeap() -> MCar*);
    mVector:wisey.data.COwnerVector*:pushBack(build(MCar).withYear(2015).onHeap() -> MCar*);

    for (int i = 0; i < mVector:wisey.data.COwnerVector*:getSize() -> long; i++) {
      printout("Car year: " + ((MCar) mVector:wisey.data.COwnerVector*:getAt(i)):MCar:getYear() -> int + "\n");
    }
    
    mVector:wisey.data.COwnerVector*:sort(this);

    for (int i = 0; i < mVector:wisey.data.COwnerVector*:getSize() -> long; i++) {
      printout("Car year: " + ((MCar) mVector:wisey.data.COwnerVector*:getAt(i)):MCar:getYear() -> int + "\n");
    }

    MCar* car = mVector:wisey.data.COwnerVector*:popBack() -> MCar*;


    printout("Car year: " + car:systems.vos.wisey.compiler.tests.MCar*:getYear() -> int + "\n");

    car = null;

    printout("Vector size: " + mVector:wisey.data.COwnerVector*:getSize() -> long + "\n");

    MCar carRef = mVector:wisey.data.COwnerVector*:getAt(0) -> MCar;


    printout("Car year: " + carRef:systems.vos.wisey.compiler.tests.MCar:getYear() -> int + "\n");
    carRef = null;

    mVector:wisey.data.COwnerVector*:clear();

    return 1;
  }

  public boolean compare(MCar left, MCar right) override {
    return left:systems.vos.wisey.compiler.tests.MCar:getYear() -> int < right:systems.vos.wisey.compiler.tests.MCar:getYear() -> int;
  }
}

bind(IProgram, CProgram);
