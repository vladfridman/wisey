package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

model MData {
  public int getResult() {
    return 3;
  }
}

controller CService {

  public int getResultFromData(MData* data) {
    return data:systems.vos.wisey.compiler.tests.MData*->getResult() ~> int;
  }
}

controller CProgram implements IProgram {
  inject CService* mService;

  public int run(immutable string[] arguments) override {
    MData* data = build(MData).onHeap() ~> MData*;
    int result = mService:systems.vos.wisey.compiler.tests.CService*->getResultFromData(data) ~> int;
    data:systems.vos.wisey.compiler.tests.MData*->getResult();
    return result;
  }
}

bind(IProgram, CProgram);
