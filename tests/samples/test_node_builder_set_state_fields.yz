package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

node NCar {
  receive int mYear;
  state NCar* mNextCar;

  public int getYear() {
    return mYear;
  }

  public NCar getNextCar() {
    return mNextCar;
  }
}

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    NCar* car2018 = build(NCar).withYear(2018).withNextCar(null).onHeap() ~> NCar*;
    NCar* car2017 = build(NCar).withYear(2017).withNextCar(car2018).onHeap() ~> NCar*;
    
    return car2017:systems.vos.wisey.compiler.tests.NCar*->getNextCar():systems.vos.wisey.compiler.tests.NCar->getYear() ~> int;
  }
}

bind(IProgram, CProgram);
