package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

model MOuterModel {
  public model MMyModel {
    int mValue;

    public int getValue() {
      return mValue;
    }
  }
}

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    MOuterModel.MMyModel* object = build(MOuterModel.MMyModel).withValue(7).onHeap() ~> MOuterModel.MMyModel*;

    return object:systems.vos.wisey.compiler.tests.MOuterModel.MMyModel*->getValue() ~> int;
  }

}

bind(IProgram, CProgram);
