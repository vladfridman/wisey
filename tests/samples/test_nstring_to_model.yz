package systems.vos.wisey.compiler.tests;

import wisey.lang.NString;
import wisey.lang.IProgram;
import wisey.lang.MString;

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    NString* nstring = NString.createFromString("123") -> NString*;
    MString* mstring = nstring:wisey.lang.NString*.toModel() -> MString*;
    printout("before: " + nstring + " length: " + nstring:wisey.lang.NString*.getLength() -> long + " capacity: " + nstring:wisey.lang.NString*.getCapacity() -> long + "\n");
    printout("after: " + mstring + " length: " + mstring:wisey.lang.MString*.getLength() -> long + "\n");
    return (int) mstring:wisey.lang.MString*.getLength() -> int;
  }
}

bind(IProgram, CProgram);
