package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

model MData {
  int mValue;

  public int getValue() {
    return mValue;
  }
}

node NNode {
  receive MData* mData;
  state NNode* mNext;

  public void setNext(NNode* next) {
    mNext = next;
  }

  public NNode getNext() {
    return mNext;
  }

  public NNode* takeNext() {
    return mNext;
  }

  public MData getData() {
    return mData;
  }
}

controller CLinkList {
  state NNode* mHead;
  state NNode mTail;

  public NNode getHead() {
    return mHead;
  }

  public NNode getTail() {
    return mTail;
  }

  public void appendToHead(MData* data) {
    NNode* newHead = build(NNode).withData(data).onHeap() ~> NNode*;
    newHead:systems.vos.wisey.compiler.tests.NNode*->setNext(mHead);
    mHead = newHead;
    if (mTail == null) {
      mTail = mHead;
    }
  }

  public void appendToTail(MData* data) {
    NNode* newNode = build(NNode).withData(data).onHeap() ~> NNode*;
    if (mHead == null) {
      mHead = newNode;
      mTail = mHead;
    } else {
      mTail:systems.vos.wisey.compiler.tests.NNode->setNext(newNode);
      mTail = mTail:systems.vos.wisey.compiler.tests.NNode->getNext() ~> NNode;
    }
  }
}

controller CProgram implements IProgram {
  inject CLinkList* mLinkList;

  public int run(immutable string[] arguments) override {
    mLinkList:systems.vos.wisey.compiler.tests.CLinkList*->appendToHead(build(MData).withValue(2).onHeap() ~> MData*);
    mLinkList:systems.vos.wisey.compiler.tests.CLinkList*->appendToHead(build(MData).withValue(1).onHeap() ~> MData*);
    mLinkList:systems.vos.wisey.compiler.tests.CLinkList*->appendToTail(build(MData).withValue(3).onHeap() ~> MData*);
    mLinkList:systems.vos.wisey.compiler.tests.CLinkList*->appendToTail(build(MData).withValue(4).onHeap() ~> MData*);

    NNode head = mLinkList:systems.vos.wisey.compiler.tests.CLinkList*->getHead() ~> NNode;
    NNode tail = mLinkList:systems.vos.wisey.compiler.tests.CLinkList*->getTail() ~> NNode;
    NNode next1 = head:systems.vos.wisey.compiler.tests.NNode->getNext() ~> NNode;
    NNode next2 = next1:systems.vos.wisey.compiler.tests.NNode->getNext() ~> NNode;
    NNode next3 = next2:systems.vos.wisey.compiler.tests.NNode->getNext() ~> NNode;
    int value0 = head:systems.vos.wisey.compiler.tests.NNode->getData():systems.vos.wisey.compiler.tests.MData->getValue() ~> int;
    int value3 = next3:systems.vos.wisey.compiler.tests.NNode->getData():systems.vos.wisey.compiler.tests.MData->getValue() ~> int;
    int valueT = tail:systems.vos.wisey.compiler.tests.NNode->getData():systems.vos.wisey.compiler.tests.MData->getValue() ~> int;
    return value0 + value3 + valueT;
  }
}

bind(IProgram, CProgram);
