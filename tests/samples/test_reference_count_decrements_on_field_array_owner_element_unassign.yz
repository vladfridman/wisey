package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

model MCar {
  public int getYear() {
    return 2018;
  }
}

controller CController {
  receive MCar[]* mArray;


  public void set(MCar car) {
    mArray[4] = car;
  }

  public int getCarYear() {
    return mArray[4]:systems.vos.wisey.compiler.tests.MCar:getYear() -> int;
  }
}

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    MCar* car = build(MCar).onHeap() -> MCar*;
    CController* mycontroller = inject(CController).withArray(new MCar[5]).onHeap() -> CController*;
    mycontroller:systems.vos.wisey.compiler.tests.CController*:set(car);
    mycontroller:systems.vos.wisey.compiler.tests.CController*:set(null);
    car = null;

    return 5;
  }
}

bind(IProgram, CProgram);

