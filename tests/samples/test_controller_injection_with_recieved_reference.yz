package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

model MIntNumber {
  int mNumber;

  public int getNumber() {
    return mNumber;
  }
}

controller CService {

  receive MIntNumber mIntNumber;

  public MIntNumber getIntNumber() {
    return mIntNumber;
  }
}

controller CProgram implements IProgram {
  inject CService* mService.withIntNumber(
    build(MIntNumber).withNumber(7).onHeap() -> MIntNumber*);

  public int run(immutable string[] arguments) override {
    return mService:systems.vos.wisey.compiler.tests.CService*:getIntNumber():systems.vos.wisey.compiler.tests.MIntNumber:getNumber() -> int;
  }
}

bind(IProgram, CProgram);
