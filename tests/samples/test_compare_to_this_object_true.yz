package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

model MComparator {
  public boolean isTheSame(MComparator pointer) {
    return this == pointer;
  }
}

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    MComparator* comparator1 = build(MComparator).onHeap() -> MComparator*;
    MComparator* comparator2 = build(MComparator).onHeap() -> MComparator*;

    return comparator1:systems.vos.wisey.compiler.tests.MComparator*.isTheSame(comparator1) -> boolean;
  }
}

bind(IProgram, CProgram);
