package systems.vos.wisey.compiler.tests;

import wisey.lang.NString;
import wisey.lang.IProgram;

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    NString* nstring = NString.createFromString("123") ~> NString*;
    printout("Before nstring: " + nstring + " capacity: " + nstring:wisey.lang.NString*->getCapacity() ~> long + "\n");
    nstring:wisey.lang.NString*->appendString("4567");
    printout("After nstring: " + nstring + " capacity: " + nstring:wisey.lang.NString*->getCapacity() ~> long + "\n");
    return (int) nstring:wisey.lang.NString*->getLength() ~> int;
  }
}

bind(IProgram, CProgram);
