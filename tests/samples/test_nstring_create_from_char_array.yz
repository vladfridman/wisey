package systems.vos.wisey.compiler.tests;

import wisey.lang.NString;
import wisey.lang.IProgram;
import wisey.lang.MString;

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    char[]* array = new char[5];
    array[0] = 'a';
    array[1] = 'b';
    array[2] = 'c';
    NString* nstring = NString.createFromCharArray(array) ~> NString*;
    printout("nstring: " + nstring + " length: " + nstring:wisey.lang.NString*->getLength() ~> long + " capacity: " + nstring:wisey.lang.NString*->getCapacity() ~> long + "\n");
    return (int) nstring:wisey.lang.NString*->getLength() ~> int;
  }
}

bind(IProgram, CProgram);
