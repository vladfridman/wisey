package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

interface IEmptyInterface {
}

interface IHasValue {
  int getValue();
}

model MHasValue implements IEmptyInterface, IHasValue {
  public int getValue() override {
    return 3;
  }
}

interface IProcessesHasValue {
  int processHasValue(IHasValue hasValue);
}

model MModel implements IProcessesHasValue {
  public int processHasValue(MHasValue hasValue) override {
    return hasValue:systems.vos.wisey.compiler.tests.MHasValue:getValue() -> int;
  }
}

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    IProcessesHasValue* processor = build(MModel).onHeap() -> MModel*;
    return processor:systems.vos.wisey.compiler.tests.IProcessesHasValue*:processHasValue(build(MHasValue).onHeap() -> MHasValue*) -> int;
  }
}

bind(IProgram, CProgram);
