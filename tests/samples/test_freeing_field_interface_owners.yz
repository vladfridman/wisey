package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

interface IHasSubModule {
  IHasValue getSubModel();
}

interface IHasValue {
  int getValue();
}

model MSubModel implements IHasValue {
  int mValue;

  public int getValue() override {
    return mValue;
  }
}

model MModel implements IHasSubModule {
  IHasValue* mSubModel;

  public IHasValue getSubModel() override {
    return mSubModel;
  }
}

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    IHasSubModule* myObject = build(MModel).withSubModel((IHasValue*) build(MSubModel).withValue(3).onHeap()).onHeap() -> MModel*;
    
    return myObject:systems.vos.wisey.compiler.tests.IHasSubModule*:getSubModel():systems.vos.wisey.compiler.tests.IHasValue:getValue() -> int;
  }
} 

bind(IProgram, CProgram);
