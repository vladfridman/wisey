package systems.vos.wisey.compiler.tests;

import wisey.lang.IException;
import wisey.lang.IProgram;
import wisey.lang.NString;

controller CResult {
  state int mValue;

  public int getValue() {
    return mValue;
  }

  public void setValue(int value) {
    mValue = value;
  }
}

model MException implements IException {

  public NString* report() override {
    return NString.create() ~> NString*;
  }
}

controller CThrower {
  public int doThrow() throws MException {
    MException* exception = build(MException).onHeap() ~> MException*;
    throw exception;
  }
}

controller CCatcher {
  inject CThrower* mThrower;

  public void doTryCatch(CResult result) throws MException {
    result:systems.vos.wisey.compiler.tests.CResult->setValue(result:systems.vos.wisey.compiler.tests.CResult->getValue() ~> int + 1);
    try {
      mThrower:systems.vos.wisey.compiler.tests.CThrower*->doThrow();
      result:systems.vos.wisey.compiler.tests.CResult->setValue(result:systems.vos.wisey.compiler.tests.CResult->getValue() ~> int + 2);
    } catch (MException* exception) {
      result:systems.vos.wisey.compiler.tests.CResult->setValue(result:systems.vos.wisey.compiler.tests.CResult->getValue() ~> int + 4);
      mThrower:systems.vos.wisey.compiler.tests.CThrower*->doThrow();
    }
    result:systems.vos.wisey.compiler.tests.CResult->setValue(result:systems.vos.wisey.compiler.tests.CResult->getValue() ~> int + 16);
  }
}

controller CProgram implements IProgram {
  inject CCatcher* mCatcher;
  inject CResult* mResult;

  public int run(immutable string[] arguments) override {
    mResult:systems.vos.wisey.compiler.tests.CResult*->setValue(0);
    try {
      mCatcher:systems.vos.wisey.compiler.tests.CCatcher*->doTryCatch(mResult);
    } catch (MException* exception) {
      mResult:systems.vos.wisey.compiler.tests.CResult*->setValue(mResult:systems.vos.wisey.compiler.tests.CResult*->getValue() ~> int + 32);
    }
    return mResult:systems.vos.wisey.compiler.tests.CResult*->getValue() ~> int;
  }
}

bind(IProgram, CProgram);
