package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;
import wisey.threads.CContextManager;

controller CCar {
  receive string mMake;

  public string getMake() {
    return mMake;
  }
}

controller CContext {

}

controller CProgram implements IProgram {
  inject CContextManager* mContextManager;
  inject CContext* mContext;

  public int run(immutable string[] arguments) override {
    string mycontext = "mycontext";
    string toyotaMake = "Toyota";
    CCar* toyota = inject(CCar).withMake(toyotaMake).onHeap() -> CCar*;

    mContextManager:wisey.threads.CContextManager*:setContext(mycontext, mContext);
    mContextManager:wisey.threads.CContextManager*:setInstance(mycontext, toyotaMake, toyota);
    CCar car = mContextManager:wisey.threads.CContextManager*:getInstance(mycontext, toyotaMake) -> CCar;
    printout("In context " + mycontext + " looking for " + toyotaMake + " got " + 
      car:systems.vos.wisey.compiler.tests.CCar:getMake() -> string + " back\n");
    car = null;

    mContextManager:wisey.threads.CContextManager*:eraseContext(mycontext);
    mContextManager:wisey.threads.CContextManager*:getInstance(mycontext, toyotaMake);

    return 1;
  }
}

bind(IProgram, CProgram);
