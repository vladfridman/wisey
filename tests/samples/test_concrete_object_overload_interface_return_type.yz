package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

interface IEmptyInterface {
}

interface IHasValue {
  int getValue();
}

model MHasValue implements IEmptyInterface, IHasValue {
  public int getValue() override {
    return 1;
  }
}

interface IReturnsHasValue {
  IHasValue getHasValue();
}

model MModel implements IReturnsHasValue {
  MHasValue* mHasValue; 

  public MHasValue getHasValue() override {
    return mHasValue;
  }
}

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    IReturnsHasValue* returner = build(MModel).withHasValue(build(MHasValue).onHeap() -> MHasValue*).onHeap() -> MModel*;
    return returner:systems.vos.wisey.compiler.tests.IReturnsHasValue*.getHasValue():systems.vos.wisey.compiler.tests.IHasValue.getValue() -> int;
  }
}

bind(IProgram, CProgram);
