package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

model MModel {
  int mValue;

  public int getValue() {
    return mValue;
  }
}

controller CProgram implements IProgram {

  private int method(::llvm::i32::pointer pointer) {
    MModel reference = pointer;
    return reference:systems.vos.wisey.compiler.tests.MModel:getValue() -> int;
  }

  public int run(immutable string[] arguments) override {
    MModel* mymodel = build(MModel).withValue(3).onHeap() -> MModel*;
    return method(mymodel) -> int;
  }
}

bind(IProgram, CProgram);
