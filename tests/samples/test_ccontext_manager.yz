package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;
import wisey.threads.CContextManager;

controller CCar {
  receive string mMake;

  public string getMake() {
    return mMake;
  }
}

controller CContext1 {

}

controller CContext2 {

}

controller CProgram implements IProgram {
  inject CContextManager* mContextManager;
  inject CContext1* mContext1;
  inject CContext2* mContext2;

  public int run(immutable string[] arguments) override {
    string context1 = "context1";
    string context2 = "context2";

    string toyotaMake = "Toyota";
    string bmwMake = "BMW";
    string mecedesMake = "Mercedes";
    CCar* toyota = inject(CCar).withMake(toyotaMake).onHeap() -> CCar*;
    CCar* bmw = inject(CCar).withMake(bmwMake).onHeap() -> CCar*;
    CCar* mercedes = inject(CCar).withMake(mecedesMake).onHeap() -> CCar*;

    mContextManager:wisey.threads.CContextManager*:setContext(context1, mContext1);
    mContextManager:wisey.threads.CContextManager*:setContext(context2, mContext2);
    mContextManager:wisey.threads.CContextManager*:setInstance(context1, toyotaMake, toyota);
    mContextManager:wisey.threads.CContextManager*:setInstance(context1, bmwMake, bmw);
    mContextManager:wisey.threads.CContextManager*:setInstance(context2, mecedesMake, mercedes);

    CCar car = mContextManager:wisey.threads.CContextManager*:getInstance(context1, toyotaMake) -> ::wisey::object;
    printout("In context " + context1 + " looking for " + toyotaMake + " got " +
      car:systems.vos.wisey.compiler.tests.CCar:getMake() -> string + " back\n");
    car = mContextManager:wisey.threads.CContextManager*:getInstance(context1, bmwMake) -> ::wisey::object;
    printout("In context " + context1 + " looking for " + bmwMake + " got " +
      car:systems.vos.wisey.compiler.tests.CCar:getMake() -> string + " back\n");

    car = mContextManager:wisey.threads.CContextManager*:getInstance(context2, mecedesMake) -> ::wisey::object;
    printout("In context " + context2 + " looking for " + mecedesMake + " got " +
      car:systems.vos.wisey.compiler.tests.CCar:getMake() -> string + " back\n");

    CCar* replacement = inject(CCar).withMake("Audi").onHeap() -> CCar*;
    mContextManager:wisey.threads.CContextManager*:setInstance(context1, bmwMake, replacement);
    car = mContextManager:wisey.threads.CContextManager*:getInstance(context1, bmwMake) -> ::wisey::object;
    printout("In context " + context2 + " looking for " + bmwMake + " got " +
      car:systems.vos.wisey.compiler.tests.CCar:getMake() -> string + " back\n");

    return 1;
  }
}

bind(IProgram, CProgram);
