package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

controller CController {
  receive int[]* mArray;

  public void init() {
    mArray[4] = 0;
  }

  public void increment() {
    mArray[4]++;
  }

  public int getValue() {
    return mArray[4];
  }
}

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    CController* mycontroller = inject(CController).withArray(new int[5]).onHeap() -> CController*;
    mycontroller:systems.vos.wisey.compiler.tests.CController*:init();
    mycontroller:systems.vos.wisey.compiler.tests.CController*:increment();
    mycontroller:systems.vos.wisey.compiler.tests.CController*:increment();
    mycontroller:systems.vos.wisey.compiler.tests.CController*:increment();
    mycontroller:systems.vos.wisey.compiler.tests.CController*:increment();
    mycontroller:systems.vos.wisey.compiler.tests.CController*:increment();

    return mycontroller:systems.vos.wisey.compiler.tests.CController*:getValue() -> int;
  }
}

bind(IProgram, CProgram);
