package systems.vos.wisey.compiler.tests;

import wisey.data.CReferenceVector;
import wisey.data.IObjectComparator;
import wisey.lang.IProgram;

model MCar {
  int mYear;

  public int getYear() {
    return mYear;
  }
}

controller CProgram implements IProgram, IObjectComparator {
  inject CReferenceVector* mVector;

  public int run(immutable string[] arguments) override {
    mVector.pushBack(build(MCar).withYear(2018).onHeap() -> MCar*);
    mVector.pushBack(build(MCar).withYear(2017).onHeap() -> MCar*);
    mVector.pushBack(build(MCar).withYear(2016).onHeap() -> MCar*);
    mVector.pushBack(build(MCar).withYear(2015).onHeap() -> MCar*);

    for (int i = 0; i < mVector.getSize(); i++) {
      printout("Car year: " + ((MCar) mVector.getAt(i)).getYear() + "\n");
    }
    
    mVector.sort(this);

    for (int i = 0; i < mVector.getSize(); i++) {
      printout("Car year: " + ((MCar) mVector.getAt(i)).getYear() + "\n");
    }

    MCar car = mVector.popBack() -> MCar;


    printout("Car year: " + car.getYear() + "\n");

    printout("Vector size: " + mVector.getSize() + "\n");

    MCar carRef = mVector.getAt(0) -> MCar;


    mVector.clear();

    printout("Car year: " + carRef.getYear() + "\n");

    return 1;
  }

  public boolean compare(MCar left, MCar right) override {
    return left.getYear() < right.getYear();
  }
}

bind(IProgram, CProgram);
