package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

interface IHasDirection {

}

interface IHasValue {
  int getValue();
}

node NYear implements IHasDirection, IHasValue {
  receive int mValue;

  public int getValue() override {
    return mValue;
  }
}

node NCar {
  state IHasValue* mYear;

  public int getYear() {
    return mYear:systems.vos.wisey.compiler.tests.IHasValue*->getValue() ~> int;
  }
}

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    NCar* car = build(NCar).withYear(build(NYear).withValue(2018).onHeap() ~> NYear*).onHeap() ~> NCar*;
    
    return car:systems.vos.wisey.compiler.tests.NCar*->getYear() ~> int;
  }
}

bind(IProgram, CProgram);
