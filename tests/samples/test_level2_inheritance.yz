package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

interface IObject {
  int getColor(int a);
}

interface IShape extends IObject {
  int getPerimeter();
  int getArea();
}

interface IClickable {
  void click();
  void tap();
}

model MSquare implements IClickable, IShape {
  int mWidth;

  public int getPerimeter() override {
    return mWidth + mWidth;
  }

  public int getArea() override {
    return mWidth * mWidth;
  }

  public int getColor(int a) override {
    return a;
  }

  public void click() override {
  }

  public void tap() override {
  }
}

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    MSquare* square = build(MSquare).withWidth(5).onHeap() -> MSquare*;

    return square.getPerimeter() -> int + square.getArea() -> int + square.getColor(55) -> int +
      ((IShape) square).getPerimeter() -> int + ((IShape) square).getArea() -> int +
      ((IShape) square).getColor(55) -> int + ((IObject) square).getColor(55) -> int;
  }
}

bind(IProgram, CProgram);
