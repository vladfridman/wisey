package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

interface IHasValue {
  int getValue();
}

controller CService implements IHasValue {
  public int getValue() override { return 1; }
}

model MCar implements IHasValue {
  public int getValue() override { return 3; }
}

node NElement {
  state IHasValue* mHasValue;

  public int getValue() {
    return mHasValue:systems.vos.wisey.compiler.tests.IHasValue*.getValue() -> int;
  }
}

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    IHasValue* car = build(MCar).onHeap() -> MCar*;
    IHasValue* service = inject(CService).onHeap() -> CService*;
    NElement* element = build(NElement).withHasValue(service).onHeap() -> NElement*;
    return element:systems.vos.wisey.compiler.tests.NElement*.getValue() -> int;
  }
}

bind(IProgram, CProgram);
