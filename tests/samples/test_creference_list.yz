package systems.vos.wisey.compiler.tests;

import wisey.data.CReferenceList;
import wisey.data.IObjectComparator;
import wisey.lang.IProgram;
import wisey.lang.MString;

model MCar {
  string mMake;

  public string getMake() {
    return mMake;
  }
}

controller CProgram implements IProgram, IObjectComparator {
  inject CReferenceList* mList;

  public int run(immutable string[] arguments) override {
    string toyotaMake = "Toyota";
    string bmwMake = "BMW";
    string mercedesMake = "Mercedes";
    MCar* toyota = build(MCar).withMake(toyotaMake).onHeap() -> MCar*;
    MCar* bmw = build(MCar).withMake(bmwMake).onHeap() -> MCar*;
    MCar* mercedes = build(MCar).withMake(mercedesMake).onHeap() -> MCar*;

    mList:wisey.data.CReferenceList*.pushBack(toyota);
    mList:wisey.data.CReferenceList*.pushBack(bmw);
    mList:wisey.data.CReferenceList*.pushFront(mercedes);

    if (bmw == null) {
      printout("bmw is null\n");
    } else {
      printout("bmw is not null\n");
    }

    printout("List size: " + mList:wisey.data.CReferenceList*.getSize() -> long + "\n");
    MCar last = mList:wisey.data.CReferenceList*.back() -> MCar;

    printout("Lookup last: " + last:systems.vos.wisey.compiler.tests.MCar.getMake() -> string + "\n");
    MCar first = mList:wisey.data.CReferenceList*.front() -> MCar;

    printout("Lookup first: " + first:systems.vos.wisey.compiler.tests.MCar.getMake() -> string + "\n");

    mList:wisey.data.CReferenceList*.sort(this);
    printout("List size: " + mList:wisey.data.CReferenceList*.getSize() -> long + "\n");
    last = mList:wisey.data.CReferenceList*.back() -> MCar;

    printout("Lookup last: " + last:systems.vos.wisey.compiler.tests.MCar.getMake() -> string + "\n");
    first = mList:wisey.data.CReferenceList*.front() -> MCar;

    printout("Lookup first: " + first:systems.vos.wisey.compiler.tests.MCar.getMake() -> string + "\n");

    MCar back = mList:wisey.data.CReferenceList*.popBack() -> MCar;

    MCar front = mList:wisey.data.CReferenceList*.popFront() -> MCar;

    printout("List size: " + mList:wisey.data.CReferenceList*.getSize() -> long + "\n");
    last = mList:wisey.data.CReferenceList*.back() -> MCar;

    printout("Lookup last: " + last:systems.vos.wisey.compiler.tests.MCar.getMake() -> string + "\n");
    first = mList:wisey.data.CReferenceList*.front() -> MCar;

    printout("Lookup first: " + first:systems.vos.wisey.compiler.tests.MCar.getMake() -> string + "\n");
    last = null;
    first = null;

    mList:wisey.data.CReferenceList*.clear();
    printout("List size: " + mList:wisey.data.CReferenceList*.getSize() -> long + "\n");

    return 1;
  }

  public boolean compare(MCar left, MCar right) override {
    return (MString.compareStrings(left:systems.vos.wisey.compiler.tests.MCar.getMake() -> string, right:systems.vos.wisey.compiler.tests.MCar.getMake() -> string) -> int) < 0;
  }
}

bind(IProgram, CProgram);
