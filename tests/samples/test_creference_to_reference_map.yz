package systems.vos.wisey.compiler.tests;

import wisey.data.CReferenceToReferenceMap;
import wisey.lang.IProgram;

model MCar {
  string mMake;

  public string getMake() {
    return mMake;
  }
}

controller CProgram implements IProgram {
  public int run(immutable string[] arguments) override {
    MCar* toyota = build(MCar).withMake("Toyota").onHeap() ~> MCar*;
    MCar* bmw = build(MCar).withMake("BMW").onHeap() ~> MCar*;
    MCar* mercedes = build(MCar).withMake("Mercedes").onHeap() ~> MCar*;
    CReferenceToReferenceMap* map = CReferenceToReferenceMap.create() ~> CReferenceToReferenceMap*;

    map:wisey.data.CReferenceToReferenceMap*->put(toyota:systems.vos.wisey.compiler.tests.MCar*->getMake() ~> string, toyota);
    map:wisey.data.CReferenceToReferenceMap*->put(bmw:systems.vos.wisey.compiler.tests.MCar*->getMake() ~> string, bmw);
    map:wisey.data.CReferenceToReferenceMap*->put(bmw:systems.vos.wisey.compiler.tests.MCar*->getMake() ~> string, bmw);
    map:wisey.data.CReferenceToReferenceMap*->put(mercedes:systems.vos.wisey.compiler.tests.MCar*->getMake() ~> string, mercedes);

    printout("Hashmap size: " + map:wisey.data.CReferenceToReferenceMap*->getSize() ~> long + "\n");

    MCar car = map:wisey.data.CReferenceToReferenceMap*->get(toyota:systems.vos.wisey.compiler.tests.MCar*->getMake() ~> string) ~> MCar;

    printout("Lookup " + toyota:systems.vos.wisey.compiler.tests.MCar*->getMake() ~> string + ": " + car:systems.vos.wisey.compiler.tests.MCar->getMake() ~> string + "\n");
    car = map:wisey.data.CReferenceToReferenceMap*->get(bmw:systems.vos.wisey.compiler.tests.MCar*->getMake() ~> string) ~> MCar;

    printout("Lookup " + bmw:systems.vos.wisey.compiler.tests.MCar*->getMake() ~> string + ": " + car:systems.vos.wisey.compiler.tests.MCar->getMake() ~> string + "\n");
    car = map:wisey.data.CReferenceToReferenceMap*->get(mercedes:systems.vos.wisey.compiler.tests.MCar*->getMake() ~> string) ~> MCar;

    printout("Lookup " + mercedes:systems.vos.wisey.compiler.tests.MCar*->getMake() ~> string + ": " + car:systems.vos.wisey.compiler.tests.MCar->getMake() ~> string + "\n");

    map:wisey.data.CReferenceToReferenceMap*->erase(bmw:systems.vos.wisey.compiler.tests.MCar*->getMake() ~> string);
    car = map:wisey.data.CReferenceToReferenceMap*->get(bmw:systems.vos.wisey.compiler.tests.MCar*->getMake() ~> string) ~> MCar;

    if (car == null) {
      printout("BMW was erased\n");
    } else {
      printout("BMW is still there\n");
    }

    map:wisey.data.CReferenceToReferenceMap*->erase(toyota:systems.vos.wisey.compiler.tests.MCar*->getMake() ~> string);
    map:wisey.data.CReferenceToReferenceMap*->erase(bmw:systems.vos.wisey.compiler.tests.MCar*->getMake() ~> string);
    map:wisey.data.CReferenceToReferenceMap*->erase(mercedes:systems.vos.wisey.compiler.tests.MCar*->getMake() ~> string);

    car = map:wisey.data.CReferenceToReferenceMap*->get(toyota:systems.vos.wisey.compiler.tests.MCar*->getMake() ~> string) ~> MCar;

    if (car == null) {
      printout("Toyota was erased\n");
    } else {
      printout("Toyota is still there\n");
    }
    car = map:wisey.data.CReferenceToReferenceMap*->get(mercedes:systems.vos.wisey.compiler.tests.MCar*->getMake() ~> string) ~> MCar;

    if (car == null) {
      printout("Mercedes was erased\n");
    } else {
      printout("Mercedes is still there\n");
    }

    return 1;
  }
}

bind(IProgram, CProgram);
