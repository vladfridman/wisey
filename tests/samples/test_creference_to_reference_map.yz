package systems.vos.wisey.compiler.tests;

import wisey.data.CReferenceToReferenceMap;
import wisey.lang.IProgram;

model MCar {
  string mMake;

  public string getMake() {
    return mMake;
  }
}

controller CProgram implements IProgram {
  public int run(immutable string[] arguments) override {
    MCar* toyota = build(MCar).withMake("Toyota").onHeap() -> MCar*;
    MCar* bmw = build(MCar).withMake("BMW").onHeap() -> MCar*;
    MCar* mercedes = build(MCar).withMake("Mercedes").onHeap() -> MCar*;
    CReferenceToReferenceMap* map = CReferenceToReferenceMap.create() -> CReferenceToReferenceMap*;

    map.put(toyota.getMake() -> string, toyota);
    map.put(bmw.getMake() -> string, bmw);
    map.put(bmw.getMake() -> string, bmw);
    map.put(mercedes.getMake() -> string, mercedes);

    printout("Hashmap size: " + map.getSize() -> long + "\n");

    MCar car = map.get(toyota.getMake() -> string) -> MCar;

    printout("Lookup " + toyota.getMake() -> string + ": " + car.getMake() -> string + "\n");
    car = map.get(bmw.getMake() -> string) -> MCar;

    printout("Lookup " + bmw.getMake() -> string + ": " + car.getMake() -> string + "\n");
    car = map.get(mercedes.getMake() -> string) -> MCar;

    printout("Lookup " + mercedes.getMake() -> string + ": " + car.getMake() -> string + "\n");

    map.erase(bmw.getMake() -> string);
    car = map.get(bmw.getMake() -> string) -> MCar;

    if (car == null) {
      printout("BMW was erased\n");
    } else {
      printout("BMW is still there\n");
    }

    map.erase(toyota.getMake() -> string);
    map.erase(bmw.getMake() -> string);
    map.erase(mercedes.getMake() -> string);

    car = map.get(toyota.getMake() -> string) -> MCar;

    if (car == null) {
      printout("Toyota was erased\n");
    } else {
      printout("Toyota is still there\n");
    }
    car = map.get(mercedes.getMake() -> string) -> MCar;

    if (car == null) {
      printout("Mercedes was erased\n");
    } else {
      printout("Mercedes is still there\n");
    }

    return 1;
  }
}

bind(IProgram, CProgram);
