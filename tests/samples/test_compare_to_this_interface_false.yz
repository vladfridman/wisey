package systems.vos.wisey.compiler.tests;

import wisey.lang.IProgram;

interface ICompareThis {
  boolean isTheSame(ICompareThis object);
}

model MComparator implements ICompareThis {
  public boolean isTheSame(ICompareThis object) override {
    return this == object;
  }
}

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    ICompareThis* comparator1 = build(MComparator).onHeap() -> MComparator*;
    ICompareThis* comparator2 = build(MComparator).onHeap() -> MComparator*;

    return comparator1.isTheSame(comparator2) -> boolean;
  }
}

bind(IProgram, CProgram);
