package systems.vos.wisey.compiler.tests;

import wisey.lang.NString;
import wisey.lang.IProgram;
import wisey.lang.MString;

controller CProgram implements IProgram {

  public int run(immutable string[] arguments) override {
    NString* nstring = NString.createFromString("test") -> NString*;
    MString* mstring = MString.createFromString("test") -> MString*;
    char[]* array = new char[5];
    array[0] = 't';
    array[1] = 'e';
    array[2] = 's';
    array[3] = 't';
    return nstring.compareToString("test") -> int
      + nstring.compareToMString(mstring) -> int
      + nstring.compareToNString(nstring) -> int
      + nstring.compareToImmutableCharArray(mstring.getContent() -> immutable char[]) -> int
      + nstring.compareToCharArray(array) -> int;
  }
}

bind(IProgram, CProgram);
